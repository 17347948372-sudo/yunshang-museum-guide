{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yunshang-museum-guide",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
